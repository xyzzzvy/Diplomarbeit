# --------------------------------------------------
# Angular / Node.js .gitignore (clean version)
# --------------------------------------------------
# Siehe: https://docs.github.com/get-started/getting-started-with-git/ignoring-files
# --------------------------------------------------

# === Build output ===
dist/
tmp/
out-tsc/
bazel-out/

# === Node modules & logs ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Angular CLI cache ===
.angular/cache/
.angular/

# === IDEs & Editors ===
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# === Visual Studio Code ===
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# === Coverage & test reports ===
coverage/
libpeerconnection.log
testem.log

# === Sass / Typings / Temp ===
.sass-cache/
connect.lock
typings/

# === System files ===
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
